# At least 2 proline residues.
# These can be L- or D- (or mixed).
PENALTY_DEFINITION
TYPE PRO DPR AIB HYP DHY
DELTA_START -2
DELTA_END 1
PENALTIES 100 50 0 0
ABSOLUTE 2
BEFORE_FUNCTION QUADRATIC
AFTER_FUNCTION CONSTANT
END_PENALTY_DEFINITION

# At most 2 ARG residues
PENALTY_DEFINITION
TYPE ARG DAR
DELTA_START -1
DELTA_END 2
PENALTIES 0 0 50 100
ABSOLUTE 2
BEFORE_FUNCTION CONSTANT
AFTER_FUNCTION QUADRATIC
END_PENALTY_DEFINITION