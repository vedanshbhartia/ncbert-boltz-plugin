<ROSETTASCRIPTS>
	<SCOREFXNS>
		# The current Rosetta default scorefunction.
		<ScoreFunction name="ref" weights="ref2015" />
		# Default scorefunction with high backbone-hbond weights plus the
		# aa_composition / netcharge / constraint terms used during design.
		<ScoreFunction name="ref_highhbond" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="10.0" />
			<Reweight scoretype="hbond_sr_bb" weight="10.0" />
			<Reweight scoretype="aa_composition" weight="1.0" />
			<Reweight scoretype="aspartimide_penalty" weight="1.0" />
			<Reweight scoretype="chainbreak" weight="200.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
			<Reweight scoretype="buried_unsatisfied_penalty" weight="0.001" />
			<Reweight scoretype="netcharge" weight="1.0" />
			<Reweight scoretype="atom_pair_constraint" weight="1.0" />
		</ScoreFunction>
		# Medium backbone-hbond weights.
		<ScoreFunction name="ref_mediumhbond" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="8.0" />
			<Reweight scoretype="hbond_sr_bb" weight="8.0" />
			<Reweight scoretype="aa_composition" weight="1.0" />
			<Reweight scoretype="aspartimide_penalty" weight="1.0" />
			<Reweight scoretype="chainbreak" weight="200.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
			<Reweight scoretype="buried_unsatisfied_penalty" weight="0.001" />
			<Reweight scoretype="netcharge" weight="1.0" />
			<Reweight scoretype="atom_pair_constraint" weight="0.7" />
		</ScoreFunction>
		# Low backbone-hbond weights.
		<ScoreFunction name="ref_lowhbond" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="6.0" />
			<Reweight scoretype="hbond_sr_bb" weight="6.0" />
			<Reweight scoretype="aa_composition" weight="1.0" />
			<Reweight scoretype="aspartimide_penalty" weight="1.0" />
			<Reweight scoretype="chainbreak" weight="200.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
			<Reweight scoretype="buried_unsatisfied_penalty" weight="0.001" />
			<Reweight scoretype="netcharge" weight="1.0" />
			<Reweight scoretype="atom_pair_constraint" weight="0.3" />
		</ScoreFunction>
		# Regular backbone-hbond weights, no pocket atom-pair constraint
		# (used for the final design round after the pocket csts are removed).
		<ScoreFunction name="ref_hbond" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="6.0" />
			<Reweight scoretype="hbond_sr_bb" weight="6.0" />
			<Reweight scoretype="aa_composition" weight="1.0" />
			<Reweight scoretype="aspartimide_penalty" weight="1.0" />
			<Reweight scoretype="chainbreak" weight="200.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
			<Reweight scoretype="buried_unsatisfied_penalty" weight="0.001" />
			<Reweight scoretype="netcharge" weight="1.0" />
		</ScoreFunction>

		# For final output scoring (keeps the design penalty terms visible in total_score).
		<ScoreFunction name="ref_output" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="6.0" />
			<Reweight scoretype="hbond_sr_bb" weight="6.0" />
			<Reweight scoretype="aa_composition" weight="1.0" />
			<Reweight scoretype="aspartimide_penalty" weight="1.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
			<Reweight scoretype="buried_unsatisfied_penalty" weight="0.001" />
			<Reweight scoretype="netcharge" weight="1.0" />
			<Reweight scoretype="atom_pair_constraint" weight="0.3" />
		</ScoreFunction>

		# Clean ref2015+hbond scorefunction for InterfaceAnalyzer, matching the
		# rest of this repo's relax scripts so dG_separated is comparable. It
		# deliberately omits the aa_composition / netcharge / atom_pair terms so
		# the reported binding energy is not polluted by design penalties.
		<ScoreFunction name="ref_iam" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="6.0" />
			<Reweight scoretype="hbond_sr_bb" weight="6.0" />
			<Reweight scoretype="chainbreak" weight="100.0" />
			<Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
		</ScoreFunction>
	</SCOREFXNS>

	# The total set of residue types the packer is allowed to design with
	# (the 20 L-amino acids come for free; this adds their D-equivalents plus
	# hydroxyproline (L/D) and AIB). The per-layer RestrictToSpecifiedBaseResidueTypes
	# task operations below trim this down position by position.
	<PACKER_PALETTES>
		<CustomBaseTypePackerPalette name="design_palette" additional_residue_types="DALA,DASP,DGLU,DPHE,DHIS,DILE,DLYS,DLEU,DASN,DPRO,DGLN,DARG,DSER,DTHR,DVAL,DTRP,DTYR,HYP,DHYP,AIB" />
	</PACKER_PALETTES>

	<RESIDUE_SELECTORS>
		# Positions with positive phi are restricted to D-amino acids; negative phi to L.
		<Phi name="posPhi" select_positive_phi="true" />
		<Phi name="negPhi" select_positive_phi="false" />
		# Burial layers, used to restrict the allowed amino-acid set per position.
		<Layer name="select_core" select_core="true" select_boundary="false" select_surface="false" core_cutoff="2.5" surface_cutoff="1.0" />
		<Layer name="select_boundary" select_core="false" select_boundary="true" select_surface="false" core_cutoff="2.5" surface_cutoff="1.0" />
		<Layer name="select_surface" select_core="false" select_boundary="false" select_surface="true" core_cutoff="2.5" surface_cutoff="1.0" />

		# This project's chain layout: peptide = chain A, MMP8 target = chain B.
		<Chain name="select_target" chains="B" />
		<Chain name="select_peptide" chains="A" />
		# First / last peptide residues, for head-to-tail cyclization bookkeeping.
		<Slice name="pep_first" selector="select_peptide" from="1" to="1" slice_mode="SPARSE" />
		<Slice name="pep_last"  selector="select_peptide" from="18" to="18" slice_mode="SPARSE" />

		# Target residues within 8 A of the peptide (repacked, never designed).
		<Neighborhood name="near_peptide_all" selector="select_peptide" distance="8.0" include_focus_in_subset="false" />
		<And name="select_near_peptide" selectors="select_target,near_peptide_all" />
		# Frozen snapshot of that neighborhood so it does not drift as design proceeds.
		<StoredResidueSubset name="get_original_near_peptide" subset_name="subset_near_peptide" />
		# Peptide + frozen neighborhood, used to anchor the pocket atom-pair csts.
		<Or name="select_pep_and_neighbors" selectors="select_peptide,get_original_near_peptide" />

		# Target residues that are far from the peptide are fully fixed (no repack).
		<Logic name="select_prevent_repack" selector="select_target and (not get_original_near_peptide)" />
		# Target residues near the peptide are repack-only (no design).
		<Logic name="select_restrict_repack" selector="get_original_near_peptide" />

		# Peptide positions where AIB has a favourable Ramachandran score.
		# (This Rosetta build's RamaMutationSelector has no sub-selector, so it
		# scores every position; intersect with the peptide to keep AIB off the target.)
		<RamaMutationSelector name="aib_rama_ok" target_type="AIB" score_threshold="-0.4" />
		<And name="aib_positions" selectors="aib_rama_ok,select_peptide" />
		<Not name="not_aib_positions" selector="aib_positions" />

		# Proline-like peptide residues, for the hard "at least 4" composition gate.
		# residue_name3 uses the same name3 codes as desired_makeup_MMP8.comp.
		<ResidueName name="proline_like_names" residue_name3="PRO,DPR,AIB,HYP,DHY" />
		<And name="pep_proline_like" selectors="select_peptide,proline_like_names" />
		# Acidic peptide residues (the cyclization handle), for the hard "at least one"
		# gate. ASP / GLU and their D-forms all carry the NEGATIVE_CHARGE property.
		<ResiduePropertySelector name="negative_charge" properties="NEGATIVE_CHARGE" />
		<And name="pep_acidic" selectors="select_peptide,negative_charge" />
	</RESIDUE_SELECTORS>

	<FILTERS>
		# Hard gate: reject the scorefunction artifact of more than 2 donors to one backbone carbonyl.
		<OversaturatedHbondAcceptorFilter name="oversat" scorefxn="ref" max_allowed_oversaturated="0" consider_mainchain_only="true" donor_selector="select_peptide" acceptor_selector="select_peptide" />
		# Report-only (confidence=0): a target-bound peptide trades internal hbonds for
		# interface hbonds, so this is recorded as a metric, not used to abort the run.
		<PeptideInternalHbondsFilter name="internal_hbonds" residue_selector="select_peptide" hbond_cutoff="6" confidence="0" />
		# Shape complementarity / interface area between target and peptide (reported).
		<ShapeComplementarity name="shape" min_sc="0" min_interface="0" residue_selector1="select_target" residue_selector2="select_peptide" write_int_area="1" confidence="1" />

		# Hard composition gates on the final designed sequence. confidence=1 means a
		# design that violates them is reported as a failure and not written out, so
		# only conforming designs leave the protocol. The soft aa_composition /
		# netcharge guidance steers the packer so these rarely have to reject.
		# Constraint: at least 1 proline-like residue.
		<ResidueCount name="min_proline_like" residue_selector="pep_proline_like" min_residue_count="1" confidence="1" />
		# Constraint: at least one ASP or GLU (L or D) for cyclization.
		<ResidueCount name="min_acidic" residue_selector="pep_acidic" min_residue_count="1" confidence="1" />
	</FILTERS>

	<TASKOPERATIONS>
		# Chirality rules from the backbone phi.
		<ProhibitResidueProperties name="no_laa_at_pos_phi" properties="L_AA" selector="posPhi" />
		<ProhibitResidueProperties name="no_daa_at_neg_phi" properties="D_AA" selector="negPhi" />
		# AIB only where its Ramachandran score is favourable.
		<ProhibitSpecifiedBaseResidueTypes name="limit_aib" base_types="AIB" selector="not_aib_positions" />
		# Never design glycine, methionine, or cysteine (L or D).
		<ProhibitSpecifiedBaseResidueTypes name="no_gly_met_cys" base_types="GLY,MET,DMET,CYS,DCYS" />

		# Buried positions: hydrophobic + proline-like set.
		<RestrictToSpecifiedBaseResidueTypes name="core_restrictions" base_types="AIB,PRO,PHE,ALA,ILE,LEU,TYR,VAL,TRP,DPRO,DPHE,DALA,DILE,DLEU,DTYR,DVAL,DTRP" selector="select_core" />
		# Boundary positions: broad set including polar/charged + proline-like.
		<RestrictToSpecifiedBaseResidueTypes name="boundary_restrictions" base_types="AIB,PRO,ALA,ILE,LEU,TYR,VAL,ASN,GLN,ASP,GLU,ARG,LYS,SER,THR,HIS,DPRO,DALA,DILE,DLEU,DTYR,DVAL,DASN,DGLN,DASP,DGLU,DARG,DLYS,DSER,DTHR,DHIS,HYP,DHYP" selector="select_boundary" />
		# Surface positions: polar/charged + proline-like (no large hydrophobics).
		<RestrictToSpecifiedBaseResidueTypes name="surf_restrictions" base_types="AIB,PRO,ALA,ASN,GLN,ASP,GLU,ARG,LYS,SER,THR,HIS,DPRO,DALA,DASN,DGLN,DASP,DGLU,DARG,DLYS,DSER,DTHR,DHIS,HYP,DHYP" selector="select_surface" />

		# Freeze far target residues; repack-only the near target residues.
		<OperateOnResidueSubset name="prevent_repack" selector="select_prevent_repack">
			<PreventRepackingRLT />
		</OperateOnResidueSubset>
		<OperateOnResidueSubset name="restrict_repack" selector="select_restrict_repack">
			<RestrictToRepackingRLT />
		</OperateOnResidueSubset>

		<ExtraRotamersGeneric name="extra_rotamer" ex1="true" ex2="true" extrachi_cutoff="0" />
		<IncludeCurrent name="include_current_rotamer" />
	</TASKOPERATIONS>

	<MOVE_MAP_FACTORIES>
		# Relax stage 1: peptide backbone + chi move, jumps fixed.
		<MoveMapFactory name="frlx_mf1" bb="false" chi="false" jumps="false">
			<Backbone residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
		# Relax stage 2/3: peptide backbone + chi move, jumps also free.
		<MoveMapFactory name="frlx_mf2" bb="false" chi="false" jumps="true">
			<Backbone residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
		# Design stage 1: chi only (no backbone), jumps fixed.
		<MoveMapFactory name="fdes_mf1" bb="false" chi="false" jumps="false">
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
		# Design stage 2: chi only, jumps free.
		<MoveMapFactory name="fdes_mf2" bb="false" chi="false" jumps="true">
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
		# Design stage 3: peptide backbone + chi move, jumps free.
		<MoveMapFactory name="fdes_mf3" bb="false" chi="false" jumps="true">
			<Backbone residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
	</MOVE_MAP_FACTORIES>

	<MOVERS>
		# Head-to-tail cyclization: bond C(res18) to N(res1), strip termini, add cutpoint variants.
		<DeclareBond name="peptide_bond" res1_selector="pep_last" atom1="C" res2_selector="pep_first" atom2="N" add_termini="true" />
		<ModifyVariantType name="remove_N_terminus" residue_selector="pep_first" remove_type="LOWER_TERMINUS_VARIANT" />
		<ModifyVariantType name="remove_C_terminus" residue_selector="pep_last" remove_type="UPPER_TERMINUS_VARIANT" />
		<ModifyVariantType name="pep_cutpoint_upper" residue_selector="pep_first" add_type="CUTPOINT_UPPER" />
		<ModifyVariantType name="pep_cutpoint_lower" residue_selector="pep_last" add_type="CUTPOINT_LOWER" />
		<ModifyVariantType name="remove_cutpoint_upper" residue_selector="pep_first" remove_type="CUTPOINT_UPPER" />
		<ModifyVariantType name="remove_cutpoint_lower" residue_selector="pep_last" remove_type="CUTPOINT_LOWER" />

		# Keep the peptide seated in the pocket during design (CA-CA harmonic csts,
		# peptide + frozen target neighborhood). Removed before the final design round.
		<AddConstraints name="add_peptide_csts" >
			<AtomPairConstraintGenerator name="peptide_csts" residue_selector="select_pep_and_neighbors" ca_only="true" native="false" sd="2" weight="1" />
		</AddConstraints>
		<RemoveConstraints name="rm_peptide_csts" constraint_generators="peptide_csts" />

		# The design constraints we are optimizing for, rather than filtering after the fact:
		#   - amino-acid composition (at least 2 proline-like, at most 2 Arg) via the aa_composition term
		#   - net charge (at most -1) via the netcharge term
		<AddCompositionConstraintMover name="addcompcsts" selector="select_peptide" filename="rosetta_only_packer_pred/desired_makeup_MMP8.comp" />
		<AddNetChargeConstraintMover name="addchargecsts" selector="select_peptide" filename="rosetta_only_packer_pred/desired_peptide.charge" />

		# Freeze the target neighborhood selection so it does not drift during design.
		<StoreResidueSubset name="store_near_peptide" subset_name="subset_near_peptide" residue_selector="select_near_peptide" />

		# Alternating rounds of repack+minimize (FastRelax) and sequence design
		# (FastDesign) while ramping the backbone-hbond emphasis down.
		<FastRelax name="frlx1" movemap_factory="frlx_mf1" scorefxn="ref_highhbond" repeats="3"
			task_operations="prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		<FastDesign name="fdes1" movemap_factory="fdes_mf1" scorefxn="ref_highhbond" repeats="3"
			task_operations="no_laa_at_pos_phi,no_daa_at_neg_phi,limit_aib,no_gly_met_cys,core_restrictions,boundary_restrictions,surf_restrictions,prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		<FastRelax name="frlx2" movemap_factory="frlx_mf2" scorefxn="ref_mediumhbond" repeats="3"
			task_operations="prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		<FastDesign name="fdes2" movemap_factory="fdes_mf2" scorefxn="ref_mediumhbond" repeats="3"
			task_operations="no_laa_at_pos_phi,no_daa_at_neg_phi,limit_aib,no_gly_met_cys,core_restrictions,boundary_restrictions,surf_restrictions,prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		<FastRelax name="frlx3" movemap_factory="frlx_mf2" scorefxn="ref_lowhbond" repeats="3"
			task_operations="prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		<FastDesign name="fdes3" movemap_factory="fdes_mf3" scorefxn="ref_hbond" repeats="3"
			task_operations="no_laa_at_pos_phi,no_daa_at_neg_phi,limit_aib,no_gly_met_cys,core_restrictions,boundary_restrictions,surf_restrictions,prevent_repack,restrict_repack,extra_rotamer,include_current_rotamer"
			packer_palette="design_palette" ramp_down_constraints="false" />

		# Interface metrics (dG_separated etc.), comparable with the repo's relax scripts.
		<InterfaceAnalyzerMover name="interface_analysis" interface="B_A" scorefxn="ref_iam" pack_separated="true" pack_input="false" />
	</MOVERS>

	<PROTOCOLS>
		# Set up cyclization on the input backbone.
		<Add mover="remove_N_terminus" />
		<Add mover="remove_C_terminus" />
		<Add mover="peptide_bond" />
		<Add mover="pep_cutpoint_upper" />
		<Add mover="pep_cutpoint_lower" />

		# Register the design requirements + freeze the pocket neighborhood.
		<Add mover="addcompcsts" />
		<Add mover="addchargecsts" />
		<Add mover="store_near_peptide" />
		<Add mover="add_peptide_csts" />

		# Round 1.
		<Add mover="frlx1" />
		<Add mover="peptide_bond" />
		<Add mover="fdes1" />
		<Add mover="peptide_bond" />
		<Add filter="oversat" />
		<Add filter="internal_hbonds" />

		# Round 2.
		<Add mover="frlx2" />
		<Add mover="peptide_bond" />
		<Add mover="fdes2" />
		<Add mover="peptide_bond" />
		<Add filter="oversat" />
		<Add filter="internal_hbonds" />

		# Round 3 (pocket csts removed first so the last design round is unrestrained).
		<Add mover="frlx3" />
		<Add mover="peptide_bond" />
		<Add mover="rm_peptide_csts" />
		<Add mover="fdes3" />
		<Add mover="peptide_bond" />
		<Add filter="oversat" />
		<Add filter="internal_hbonds" />

		# Hard composition gates on the final sequence, before the expensive interface
		# analysis so designs that violate them fail fast (and are not written out).
		<Add filter="min_proline_like" />
		<Add filter="min_acidic" />

		# Final metrics: drop the cutpoint variants, re-declare the bond, measure SC + interface.
		<Add mover="remove_cutpoint_upper" />
		<Add mover="remove_cutpoint_lower" />
		<Add mover="peptide_bond" />
		<Add filter="shape" />
		<Add mover="interface_analysis" />
	</PROTOCOLS>

	<OUTPUT scorefxn="ref_output" />
</ROSETTASCRIPTS>
