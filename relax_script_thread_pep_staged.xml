<ROSETTASCRIPTS>
	<SCOREFXNS>
		<!-- The current Rosetta default scorefunction. -->
		<ScoreFunction name="ref" weights="ref2015" />
		<!-- The default scorefunction with regular hydrogen bond weights and cyclic backbone constraint. -->
		<ScoreFunction name="ref_hbond" weights="ref2015" >
			<Reweight scoretype="hbond_lr_bb" weight="6.0" />
			<Reweight scoretype="hbond_sr_bb" weight="6.0" />
			<Reweight scoretype="chainbreak" weight="100.0" />
            <Reweight scoretype="omega" weight="2.0" />
			<Reweight scoretype="voids_penalty" weight="0.01" />
		</ScoreFunction>
	</SCOREFXNS>

	<!-- The PACKER_PALETTES section defines the total set of residues with which we're designing. -->
	<PACKER_PALETTES>
		<CustomBaseTypePackerPalette name="design_palette" additional_residue_types="DALA,DASP,DGLU,DPHE,DHIS,DILE,DLYS,DLEU,DASN,DPRO,DGLN,DARG,DSER,DTHR,DVAL,DTRP,DTYR,NLU,DNLU,NVL,DNVL,A12,DA12,B27,DB27,B30,DB30,BB8,DBB8,ORN,DORN,DPP,DDPP,DAB,DDAB,HYP,DHYP,AIB" />
	</PACKER_PALETTES>

	<!-- The RESIDUE_SELECTORS section allows users to configure tools to select residues, -->
	<!-- which are used when setting up other Rosetta modules. -->
	<RESIDUE_SELECTORS>
		<!-- Select MMP8 and peptide residues. -->
		<Chain name="select_MMP8" chains="A" />
		<Chain name="select_peptide" chains="B" />
		<Slice name="pep_first" selector="select_peptide" from="1" to="1" slice_mode="SPARSE"/>
		<!-- This protocol expects an 18-residue peptide on chain B. -->
		<Slice name="pep_last"  selector="select_peptide" from="18" to="18" slice_mode="SPARSE"/>
		<!-- Retrieve the original select_near_peptide residue subset created by the "StoreResidueSubset" mover -->
		<Neighborhood name="near_peptide_all" selector="select_peptide" distance="8.0" include_focus_in_subset="false"/>
		<And name="select_near_peptide" selectors="select_MMP8,near_peptide_all"/>
		<StoredResidueSubset name="get_original_near_peptide" subset_name="subset_near_peptide"/>
	</RESIDUE_SELECTORS>

	<!-- The FILTERS section allows users to configure filters. -->
	<FILTERS>
		<!-- Filter to avoid score function artifact of having more than two hydrogen bonds to carbonyls. -->
		<OversaturatedHbondAcceptorFilter name="oversat" scorefxn="ref" max_allowed_oversaturated="0" consider_mainchain_only="true" donor_selector="select_peptide" acceptor_selector="select_peptide" />
		<!-- Filter to ensure a minimum number of hbonds in the peptide. -->
		<!-- <PeptideInternalHbondsFilter name="min_internal_hbonds" residue_selector="select_peptide" hbond_cutoff="3" scorefxn="ref_hbond" /> -->
		<!-- Filter to ensure minimum shape complementarity and interface area -->
		<ShapeComplementarity name="shape" min_sc="0" min_interface="0" residue_selector1="select_MMP8" residue_selector2="select_peptide" write_int_area="1" confidence="1" />
	</FILTERS>

	<!-- The TASKOPERATIONS section allows users to configure task operations, which are Rosetta modules that control the -->
	<!-- behavior of Rosetta's "Packer" module.  The Packer, in turn, is used for side-chain identity and rotamer optimization. -->
	<TASKOPERATIONS>
		<!-- Increase the fineness of the discretization of conformational rotamers, sampling chi1 and chi2 more finely. -->
		<ExtraRotamersGeneric name="extra_rotamer" ex1="true" ex2="true" extrachi_cutoff="0" />
		<IncludeCurrent name="include_current_rotamer" />
	</TASKOPERATIONS>

	<MOVE_MAP_FACTORIES>
		<!-- First stage only repacks/minimizes sidechains. -->
		<MoveMapFactory name="frlx_fixed_mf" bb="false" chi="false" jumps="false">
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
		<!-- Second stage restores peptide backbone minimization. -->
		<MoveMapFactory name="frlx_move_mf" bb="false" chi="false" jumps="false">
			<Backbone residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="select_peptide" enable="true" />
			<Chi residue_selector="get_original_near_peptide" enable="true" />
		</MoveMapFactory>
	</MOVE_MAP_FACTORIES>

	<!-- The MOVERS section allows users to define movers, which are Rosetta modules -->
	<!-- that modify a structure in some way: -->
	<MOVERS>
		<!-- A mover to declare a bond connecting the termini, upper cutpoint is with N terminal, lower with C terminal -->
		<DeclareBond name="peptide_bond" res1_selector="pep_last" atom1="C" res2_selector="pep_first" atom2="N" add_termini="true" />
		
		<!-- Add two virtual atoms to each cutpoint, virtual CA and C before the upper cutpoint, virtual N and CA after the lower cutpoint -->
		<!-- Want the virtual atoms to align with the real ones so that cyclization is ideal -->
		<ModifyVariantType name="remove_N_terminus" residue_selector="pep_first" remove_type="LOWER_TERMINUS_VARIANT" />
        <ModifyVariantType name="remove_C_terminus" residue_selector="pep_last" remove_type="UPPER_TERMINUS_VARIANT" />
        <ModifyVariantType name="pep_cutpoint_upper" residue_selector="pep_first" add_type="CUTPOINT_UPPER" />
        <ModifyVariantType name="pep_cutpoint_lower" residue_selector="pep_last" add_type="CUTPOINT_LOWER" />
        <ModifyVariantType name="remove_cutpoint_upper" residue_selector="pep_first" remove_type="CUTPOINT_UPPER" />
		<ModifyVariantType name="remove_cutpoint_lower" residue_selector="pep_last" remove_type="CUTPOINT_LOWER" />

		<!-- Store the MMP8 residue selection close to the peptide to avoid selection changes caused by peptide design -->
		<StoreResidueSubset name="store_near_peptide" subset_name="subset_near_peptide" residue_selector="select_near_peptide" />

		<!-- Thread a new peptide sequence onto chain B (starting at residue 162B). -->
		<SimpleThreadingMover name="thread_peptide" start_position="162B" thread_sequence="%%pepseq%%" sequence_mode="oneletter" pack_neighbors="true" neighbor_dis="8.0" pack_rounds="1" />

		<FastRelax name="frlx_fixed" movemap_factory="frlx_fixed_mf" scorefxn="ref_hbond" repeats="3" disable_design="true" task_operations="extra_rotamer,include_current_rotamer" />
		<FastRelax name="frlx_move" movemap_factory="frlx_move_mf" scorefxn="ref_hbond" repeats="3" disable_design="true" task_operations="extra_rotamer,include_current_rotamer" />
	</MOVERS>

	<!-- The PROTOCOLS section is the section in which the user invokes the modules -->
	<!-- defined above in linear sequence to define a protocol: -->
	<PROTOCOLS>
		<!-- Remove the termini labels and add cutpoint variants for cyclization -->
		<Add mover="thread_peptide" />
		<Add mover="remove_N_terminus" />
        <Add mover="remove_C_terminus" />
		<Add mover="peptide_bond" />
		<Add mover="pep_cutpoint_upper" />
		<Add mover="pep_cutpoint_lower" />

		<!-- Store the residue subset near the peptide, only those sidechains in the MMP8 protein will be allowed to move -->
		<Add mover="store_near_peptide" />

		<!-- FastRelax -->
		<Add mover="frlx_fixed" />
		<Add mover="peptide_bond" />

		<Add filter="oversat" />
		
		<!-- This mover is needed to correct the O and H atom positions at the cyclization site -->
		<Add mover="peptide_bond" />
		<!-- Re-minimize to fix closure -->
		<Add mover="frlx_move" />

		<!-- Measure shape complementarity and interface area -->
		<Add filter="shape" />
	</PROTOCOLS>
	
	<!-- We specify the scoring function that will be used to score the output structure. -->
	<OUTPUT scorefxn="ref_hbond" />
</ROSETTASCRIPTS>
